<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">
<Scripts>
    <Script file="AutoBandWindow.lua" />
    <Script file="AutoBandWindowLeaderPromotionPopup.lua" />
    <Script file="AutoBandWindowScoreboardPreview.lua" />
</Scripts>

<Assets>
    <Texture name="ab_icon" file="ab_icon.tga" />
    <Texture name="ab_icon_over" file="ab_icon_over.tga" />
</Assets>

<Windows>
    <Window name="AutoBandWindow" inherits="EA_Window_Default" movable="true" layer="secondary" savesettings="false">
        <!-- 600 wide; height is set per tab (AutoBandWindow.PAGE_HEIGHTS) keeping the top edge.
             Title 0-32, tabs 32-67, global strip 68-116 (controls centred, stock separator
             line on its bottom edge), page area 134 to height-78 (content from y 138, 6 clear
             above the footer), 72-high stock footer bar from height-72 with 39-high buttons
             from height-51 to height-12 and footer text centred on them. -->
        <Size>
            <AbsPoint x="600" y="885" />
        </Size>
        <Anchors>
            <Anchor point="center" relativePoint="center" />
        </Anchors>

        <EventHandlers>
            <EventHandler event="OnInitialize" function="AutoBandWindow.Initialize" />
        </EventHandlers>

        <Windows>
            <!-- Title Bar, Close button, and Corner Image -->
            <Window name="$parentTitleBar" inherits="EA_TitleBar_Default" />
            <Button name="$parentClose" inherits="EA_Button_DefaultWindowClose">
                <EventHandlers>
                    <EventHandler event="OnLButtonUp" function="AutoBandWindow.Hide" />
                </EventHandlers>
            </Button>
            <Label name="$parentWarbandDisabledLabel" inherits="EA_Label_DefaultText" font="font_clear_small" textalign="right" wordwrap="false" handleinput="true" mouseovertext="false" layer="overlay">
                <Size>
                    <AbsPoint x="90" y="20" />
                </Size>
                <Anchors>
                    <Anchor point="topright" relativePoint="topright" relativeTo="$parentTitleBar">
                        <AbsPoint x="-38" y="7" />
                    </Anchor>
                </Anchors>
                <Color r="255" g="128" b="64" />
                <EventHandlers>
                    <EventHandler event="OnMouseOver" function="AutoBandWindow.OnWarbandDisabledMouseOver" />
                    <EventHandler event="OnMouseOverEnd" function="AutoBandWindow.OnWarbandDisabledMouseOverEnd" />
                    <EventHandler event="OnRButtonUp" function="AutoBandWindow.OnWarbandDisabledRightClick" />
                </EventHandlers>
            </Label>

            <!-- Main Window Background -->
            <Window name="$parentBackground" inherits="EA_Window_DefaultBackgroundFrame" handleinput="true" popable="false">
                <Anchors>
                    <Anchor point="topleft" relativePoint="topleft" >
                        <AbsPoint x="0" y="32" />
                    </Anchor>
                    <Anchor point="bottomright" relativePoint="bottomright" />
                </Anchors>
            </Window>

            <!-- Dark backing behind the strip and pages so world text does not show through -->
            <FullResizeImage name="$parentPageBacking" inherits="EA_FullResizeImage_TintableSolidBackground" handleinput="false" layer="background" alpha="0.8">
                <Anchors>
                    <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                        <AbsPoint x="8" y="67" />
                    </Anchor>
                    <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
                        <AbsPoint x="-8" y="-72" />
                    </Anchor>
                </Anchors>
                <TintColor r="0" g="0" b="0" />
            </FullResizeImage>
            <FullResizeImage name="$parentGlobalStripBacking" inherits="EA_FullResizeImage_TintableSolidBackground" handleinput="false" layer="background" alpha="0.8">
                <Size>
                    <AbsPoint x="580" y="48" />
                </Size>
                <Anchors>
                    <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                        <AbsPoint x="10" y="68" />
                    </Anchor>
                    <Anchor point="topright" relativePoint="topright" relativeTo="$parent">
                        <AbsPoint x="-10" y="68" />
                    </Anchor>
                </Anchors>
                <TintColor r="0" g="0" b="0" />
            </FullResizeImage>

            <!-- Tabs: original Templates | Tools | Config, plus Realm; ids match AB_const.TABS_* -->
            <Window name="$parentTabs">
                <Size>
                    <AbsPoint x="600" y="35" />
                </Size>
                <Anchors>
                    <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                        <AbsPoint x="0" y="32" />
                    </Anchor>
                </Anchors>
                <Windows>
                    <Window name="$parentSeparatorLeft" inherits="EA_Window_TabSeparatorLeftSide" layer="background" popable="false">
                        <Anchors>
                            <Anchor point="bottomleft" relativePoint="bottomleft">
                                <AbsPoint x="0" y="-6" />
                            </Anchor>
                            <Anchor point="bottomleft" relativePoint="topright" relativeTo="$parentTemplate">
                                <AbsPoint x="0" y="-6" />
                            </Anchor>
                        </Anchors>
                    </Window>
                    <Button name="$parentTemplate" inherits="EA_Button_Tab" id="1">
                        <Size>
                            <AbsPoint x="135" y="35" />
                        </Size>
                        <TextOffset x="0" y="5" />
                        <Anchors>
                            <Anchor point="topleft" relativePoint="topleft">
                                <AbsPoint x="30" y="0" />
                            </Anchor>
                        </Anchors>
                        <EventHandlers>
                            <EventHandler event="OnLButtonUp" function="AutoBandWindow.OnLButtonUpTab" />
                            <EventHandler event="OnMouseOver" function="AutoBandWindow.OnTabMouseOver" />
                            <EventHandler event="OnMouseOverEnd" function="AutoBandWindow.OnFooterMouseOverEnd" />
                        </EventHandlers>
                    </Button>
                    <Button name="$parentTools" inherits="EA_Button_Tab" id="2">
                        <Size>
                            <AbsPoint x="135" y="35" />
                        </Size>
                        <TextOffset x="0" y="5" />
                        <Anchors>
                            <Anchor point="topleft" relativePoint="topleft">
                                <AbsPoint x="165" y="0" />
                            </Anchor>
                        </Anchors>
                        <EventHandlers>
                            <EventHandler event="OnLButtonUp" function="AutoBandWindow.OnLButtonUpTab" />
                            <EventHandler event="OnMouseOver" function="AutoBandWindow.OnTabMouseOver" />
                            <EventHandler event="OnMouseOverEnd" function="AutoBandWindow.OnFooterMouseOverEnd" />
                        </EventHandlers>
                    </Button>
                    <Button name="$parentConfig" inherits="EA_Button_Tab" id="3">
                        <Size>
                            <AbsPoint x="135" y="35" />
                        </Size>
                        <TextOffset x="0" y="5" />
                        <Anchors>
                            <Anchor point="topleft" relativePoint="topleft">
                                <AbsPoint x="300" y="0" />
                            </Anchor>
                        </Anchors>
                        <EventHandlers>
                            <EventHandler event="OnLButtonUp" function="AutoBandWindow.OnLButtonUpTab" />
                            <EventHandler event="OnMouseOver" function="AutoBandWindow.OnTabMouseOver" />
                            <EventHandler event="OnMouseOverEnd" function="AutoBandWindow.OnFooterMouseOverEnd" />
                        </EventHandlers>
                    </Button>
                    <Button name="$parentRealm" inherits="EA_Button_Tab" id="4">
                        <Size>
                            <AbsPoint x="135" y="35" />
                        </Size>
                        <TextOffset x="0" y="5" />
                        <Anchors>
                            <Anchor point="topleft" relativePoint="topleft">
                                <AbsPoint x="435" y="0" />
                            </Anchor>
                        </Anchors>
                        <EventHandlers>
                            <EventHandler event="OnLButtonUp" function="AutoBandWindow.OnLButtonUpTab" />
                            <EventHandler event="OnMouseOver" function="AutoBandWindow.OnTabMouseOver" />
                            <EventHandler event="OnMouseOverEnd" function="AutoBandWindow.OnFooterMouseOverEnd" />
                        </EventHandlers>
                    </Button>
                    <Window name="$parentSeparatorRight" inherits="EA_Window_TabSeparatorRightSide" layer="background" popable="false">
                        <Anchors>
                            <Anchor point="bottomright" relativePoint="topleft" relativeTo="$parentRealm">
                                <AbsPoint x="0" y="-6" />
                            </Anchor>
                            <Anchor point="bottomright" relativePoint="bottomright">
                                <AbsPoint x="0" y="-6" />
                            </Anchor>
                        </Anchors>
                    </Window>
                </Windows>
            </Window>

            <!-- Global strip: visible on every tab -->
            <Button name="$parentPmBlockCheckBox" inherits="EA_Button_DefaultCheckBox">
                <Anchors>
                    <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
