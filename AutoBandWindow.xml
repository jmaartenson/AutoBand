                    <EventHandler event="OnMouseOver" function="AutoBandWindow.OnPmBlockMouseOver" />
                    <EventHandler event="OnMouseOverEnd" function="AutoBandWindow.OnStripMouseOverEnd" />
                </EventHandlers>
            </Label>
            <Button name="$parentWarbandCheckBox" inherits="EA_Button_DefaultCheckBox">
