                <Anchors>
                    <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                        <AbsPoint x="0" y="134" />
                    </Anchor>
                    <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
                        <AbsPoint x="0" y="-78" />
                    </Anchor>
                </Anchors>
            </Window>

            <Window name="AutoBandWindowTemplateTab" inherits="AutoBandWindowTemplate" />
            <Window name="AutoBandWindowToolsTab" inherits="AutoBandWindowTools" />
            <Window name="AutoBandWindowConfigTab" inherits="AutoBandWindowConfig" />
            <Window name="AutoBandWindowRealmTab" inherits="AutoBandWindowRealm" />

            <!-- Footer (Tools, Config, Realm): Restore Defaults, active preset, version.
                 Templates shows its own original footer (Save, Delete/Reset ... Apply). -->
            <Window name="$parentButtonBar" inherits="EA_Window_DefaultButtonBottomFrame" layer="background">
                <Size>
                    <AbsPoint x="600" y="72" />
                </Size>
                <Anchors>
                    <Anchor point="bottomleft" relativePoint="bottomleft" relativeTo="$parent">
                        <AbsPoint x="0" y="0" />
                    </Anchor>
                    <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
                        <AbsPoint x="0" y="0" />
                    </Anchor>
                </Anchors>
            </Window>
            <Button name="$parentPageDefaultsButton" inherits="EA_Button_DefaultResizeable">
                <Size>
                    <AbsPoint x="180" y="39" />
                </Size>
                <Anchors>
                    <Anchor point="bottomleft" relativePoint="bottomleft" relativeTo="$parent">
                        <AbsPoint x="24" y="-12" />
                    </Anchor>
                </Anchors>
                <EventHandlers>
                    <EventHandler event="OnLButtonUp" function="AutoBandWindow.OnPageDefaults" />
                    <EventHandler event="OnMouseOver" function="AutoBandWindow.OnPageDefaultsMouseOver" />
                    <EventHandler event="OnMouseOverEnd" function="AutoBandWindow.OnFooterMouseOverEnd" />
                </EventHandlers>
            </Button>
            <!-- Footer text: own left/right midpoint on the buttons' centre line (height-32);
                 the height is set to the measured text height at runtime. -->
            <Label name="$parentPresetLabel" inherits="EA_Label_DefaultText_Small" font="font_clear_small" textalign="left" wordwrap="false" handleinput="true">
                <Size>
                    <AbsPoint x="264" y="20" />
                </Size>
                <Anchors>
                    <Anchor point="bottomleft" relativePoint="left" relativeTo="$parent">
                        <AbsPoint x="216" y="-32" />
                    </Anchor>
                </Anchors>
                <EventHandlers>
                    <EventHandler event="OnLButtonUp" function="AutoBandWindow.OnPresetLabelClick" />
                    <EventHandler event="OnMouseOver" function="AutoBandWindow.OnPresetLabelMouseOver" />
                    <EventHandler event="OnMouseOverEnd" function="AutoBandWindow.OnFooterMouseOverEnd" />
                </EventHandlers>
            </Label>
            <Label name="$parentVersionLabel" inherits="EA_Label_DefaultText" textalign="right" wordwrap="false" handleinput="true">
                <Size>
                    <AbsPoint x="80" y="20" />
                </Size>
                <Anchors>
                    <Anchor point="bottomright" relativePoint="right" relativeTo="$parent">
                        <AbsPoint x="-24" y="-32" />
                    </Anchor>
                </Anchors>
                <EventHandlers>
                    <EventHandler event="OnMouseOver" function="AutoBandWindow.OnVersionMouseOver" />
                    <EventHandler event="OnMouseOverEnd" function="AutoBandWindow.OnFooterMouseOverEnd" />
                </EventHandlers>
            </Label>
        </Windows>
    </Window>    <!-- AutoBandWindow -->

    <Window name="AutoBandMapIcon" layer="default" movable="false" popable="false" savesettings="true">
        <Size>
            <AbsPoint x="32" y="32"/>
        </Size>
        <Anchors>
            <Anchor point="bottomright"
                    relativeTo="EA_Window_OverheadMapMapDisplay"
                    relativePoint="topleft">
                <AbsPoint x="-75" y="-15" />
            </Anchor>
        </Anchors>
        <Windows>
            <Button name="$parentButton" inherits="DefaultButton" backgroundtexture="ab_icon" highlighttexture="ab_icon_over" layer="default" texturescale="1">
                <Size>
                    <AbsPoint x="32" y="32"/>
                </Size>
                                <EventHandlers>
                                        <EventHandler event="OnLButtonUp" function="AutoBand.cmd_toggle_gui"/>
                                        <EventHandler event="OnRButtonUp" function="AutoBand.HandleIconRightClick"/>
                                        <EventHandler event="OnMouseOver" function="AutoBand.OnIconMouseOver" />
                                        <EventHandler event="OnMouseLeave" function="AutoBand.OnIconMouseLeave" />
                                </EventHandlers>
                <TexSlices>
                    <Normal id="SquareButton" /> 
                    <NormalHighlit id="SquareButton-Rollover" /> 
