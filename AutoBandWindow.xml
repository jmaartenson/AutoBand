            <Label name="$parentPmBlockLabel" inherits="EA_Label_DefaultText" font="font_clear_medium_bold" textalign="left" wordwrap="false" handleinput="true">
                <Size>
                    <AbsPoint x="230" y="26" />
                </Size>
                <Anchors>
                    <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
