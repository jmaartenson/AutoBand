                        <AbsPoint x="306" y="81" />
                    </Anchor>
                </Anchors>
                <EventHandlers>
                    <EventHandler event="OnLButtonUp" function="AutoBandWindow.OnWarbandCheckBox" />
                    <EventHandler event="OnMouseOver" function="AutoBandWindow.OnWarbandMouseOver" />
                    <EventHandler event="OnMouseOverEnd" function="AutoBandWindow.OnStripMouseOverEnd" />
                </EventHandlers>
            </Button>
            <Label name="$parentWarbandLabel" inherits="EA_Label_DefaultText" font="font_clear_medium_bold" textalign="left" wordwrap="false" handleinput="true">
                <Size>
                    <AbsPoint x="220" y="26" />
                </Size>
                <Anchors>
                    <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                        <AbsPoint x="334" y="85" />
                    </Anchor>
                </Anchors>
                <EventHandlers>
                    <EventHandler event="OnLButtonUp" function="AutoBandWindow.OnClickWarbandLabel" />
                    <EventHandler event="OnMouseOver" function="AutoBandWindow.OnWarbandMouseOver" />
                    <EventHandler event="OnMouseOverEnd" function="AutoBandWindow.OnStripMouseOverEnd" />
                </EventHandlers>
            </Label>

            <!-- Separator under the global strip -->
            <Window name="$parentGlobalStripSeparator" inherits="EA_Window_DefaultSeparator" layer="background" handleinput="false">
                <Anchors>
                    <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                        <AbsPoint x="0" y="106" />
                    </Anchor>
                    <Anchor point="topright" relativePoint="topright" relativeTo="$parent">
                        <AbsPoint x="0" y="106" />
                    </Anchor>
                </Anchors>
            </Window>

            <!-- Page area (pages anchor to it): y 134 to height-78 -->
